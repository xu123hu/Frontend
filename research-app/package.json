{
  "name": "research-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "智学数研 · 科研端前端（Evidence-Native Research OS）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue,.js --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bundle-report": "vite build --mode production && du -sh dist/assets/*.js | sort -k1 -h"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@headlessui/vue": "^1.7.22",
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@tanstack/vue-query": "^5.51.0",
    "@tanstack/vue-table": "^8.20.0",
    "@tanstack/vue-virtual": "^3.10.0",
    "@vueuse/core": "^10.11.0",
    "katex": "^0.16.10",
    "lucide-vue-next": "^0.400.0",
    "marked": "^13.0.0",
    "pdfjs-dist": "^4.4.168",
    "pinia": "^2.2.0",
    "vue": "^3.4.31",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.26"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}